{
  "expo": {
    "name": "LuxCare",
    "slug": "luxcare-mobile",
    "scheme": "luxcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "LuxCare cần quyền truy cập thư viện ảnh để đính kèm tệp và tải lên ảnh đại diện.",
        "NSCameraUsageDescription": "LuxCare cần quyền truy cập máy ảnh để chụp ảnh chấm công và ảnh đại diện."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-notifications", { "defaultChannel": "default", "color": "#065f46" }],
      "expo-secure-store",
      "expo-router",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "LuxCare cần camera để chụp ảnh xác nhận chấm công.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LuxCare cần vị trí hiện tại để xác nhận địa điểm chấm công."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LuxCare cần quyền truy cập thư viện ảnh để tải lên ảnh đại diện.",
          "cameraPermission": "LuxCare cần quyền truy cập máy ảnh để chụp ảnh đại diện."
        }
      ],
      "expo-font",
      "expo-video"
    ]
  }
}
